{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
	"source": "~/.config/fastfetch/logo.txt",
    },
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m{##ed7297}┌──────────────────────Hardware──────────────────────┐"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "#b5335a"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#b5335a"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#b5335a"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "#b5335a"
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "#b5335a"
        },
        {
            "type": "custom",
            "format": "\u001b[90m{##ed7297}└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m{##ed7297}┌──────────────────────Software──────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#b5335a"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#b5335a"
        },
        {
            "type": "bios",
            "key": "│ ├",
            "keyColor": "#b5335a"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#b5335a"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "#b5335a"
        },
        "break",
        {
            "type": "de",
            "key": " DE",
            "keyColor": "#b5335a" 
        },
        {
            "type": "lm",
            "key": "│ ├",
            "keyColor": "#b5335a" 
        },
        {
            "type": "wm",
            "key": "│ ├",
            "keyColor": "#b5335a" 
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#b5335a" 
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "#b5335a" 
        },
        {
            "type": "custom",
            "format": "\u001b[90m{##ed7297}└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m{##ed7297}┌────────────────────Uptime / Age / DT───────────────┐"
        },
        {
            "type": "command",
            "key": "  OS Age ",
            "keyColor": "#b5335a",
            "text": "f=\"${XDG_STATE_HOME:-$HOME/.local/state}/fastfetch/install_date\"; birth_install=$(cat \"$f\" 2>/dev/null); case \"$birth_install\" in ''|*[!0-9]*) birth_install=$(stat -c %W /);; esac; current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "#b5335a" 
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "#b5335a" 
        },
        {
            "type": "custom",
            "format": "\u001b[90m{##ed7297}└────────────────────────────────────────────────────┘"
        },

//        {
//            "type": "colors"
//        },

        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
 
    ]
}
