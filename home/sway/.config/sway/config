# Sway port of ~/Old/Dots/hypr (animations, blur, shadows, rounding and
# anything needing apps not installed here are left out).
# Read `man 5 sway` for a complete reference.

### Apps
set $mod Mod4
set $term foot
set $browser qutebrowser
# Per-machine overrides of the above. The browsers package (not stowed by
# `install.sh -l`) drops one here that makes $browser Firefox and moves
# qutebrowser to $mod+Ctrl+b. Has to come before the bindings that use them.
include apps.d/*
# tofi as a minibuffer over the bar; wmenu until tofi is installed.
set $menu sh -c 'if command -v tofi-drun >/dev/null; then tofi-drun; else wmenu-run -b; fi'
set $lock ~/.config/sway/scripts/lock

### Outputs
output * scale 1
# Re-enabled on every reload, so a reload undoes the external-only toggle.
output eDP-1 position 0 0 scale 1 enable

# Laptop panel keeps 1-5, externals start at 6.
workspace 1 output eDP-1
workspace 2 output eDP-1
workspace 3 output eDP-1
workspace 4 output eDP-1
workspace 5 output eDP-1
workspace 6 output DP-1 DP-2 DP-3 HDMI-A-1 HDMI-A-2 eDP-1
workspace 7 output DP-1 DP-2 DP-3 HDMI-A-1 HDMI-A-2 eDP-1
workspace 8 output DP-1 DP-2 DP-3 HDMI-A-1 HDMI-A-2 eDP-1
workspace 9 output DP-1 DP-2 DP-3 HDMI-A-1 HDMI-A-2 eDP-1
workspace 10 output DP-1 DP-2 DP-3 HDMI-A-1 HDMI-A-2 eDP-1

### Wallpaper (awww; qs -c wicky picks from ~/Pictures/Wallpapers)
# awww-daemon restores the last wallpaper itself; frog.jpg only on first run.
exec sh -c 'awww-daemon & sleep 1; awww query | grep -q image: || awww img ~/Pictures/Wallpapers/frog.jpg'

### Notifications (mako; notif-menu drives it)
exec mako

### Idle (port of hypridle.conf; the brightness dim step needs brightnessctl)
exec swayidle -w \
    timeout 300 'loginctl lock-session' \
    timeout 330 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    timeout 1800 'systemctl suspend' \
    lock '$lock' \
    before-sleep 'loginctl lock-session' \
    after-resume 'swaymsg "output * power on"'

### Input
input type:keyboard {
    xkb_layout gb
    xkb_options caps:swapescape
}

input type:touchpad {
    natural_scroll enabled
}

focus_follows_mouse yes
seat seat0 xcursor_theme default 24
# Hide the cursor after 3s idle, and immediately while typing.
seat * hide_cursor 3000
seat * hide_cursor when-typing enable

bindgesture swipe:3:left workspace next_on_output
bindgesture swipe:3:right workspace prev_on_output

### Style
default_border pixel 2
default_floating_border pixel 2
gaps inner 2
gaps outer 3

# class                 border  bg      text    indicator child_border
client.focused          #993954 #993954 #cdd6f4 #ae76a6   #993954
client.focused_inactive #595959 #595959 #cdd6f4 #595959   #595959
client.unfocused        #595959 #595959 #cdd6f4 #595959   #595959

for_window [all] opacity 0.9

### Key bindings
bindsym $mod+Return exec $term
bindsym $mod+b exec $browser
bindsym $mod+g exec qutebrowser --target window github.com
bindsym $mod+c exec qutebrowser --target window claude.ai/chat
bindsym $mod+d exec $menu
bindsym $mod+e exec $term yazi
bindsym $mod+w exec qs -c wicky -n
bindsym $mod+v exec qs -c vicky -n

# System menus (quicky menus in hyprland; tofi menus here, TUIs as a fallback).
bindsym $mod+Shift+w exec ~/.config/sway/scripts/wifi-menu
bindsym $mod+Shift+b exec ~/.config/sway/scripts/bt-menu
bindsym $mod+Shift+d exec ~/.config/sway/scripts/power-profile-menu
bindsym $mod+Shift+n exec ~/.config/sway/scripts/notif-menu
bindsym $mod+Ctrl+p exec ~/.config/sway/scripts/power-menu
for_window [app_id="floating-menu"] floating enable, resize set 900 600, move position center

# Emacs-style minibuffer (tofi): C-x C-f, M-x and M-! stand-ins.
bindsym $mod+o exec ~/.config/sway/scripts/find-file
bindsym $mod+x exec ~/.config/sway/scripts/mx
bindsym $mod+Shift+x exec ~/.config/sway/scripts/run-cmd

bindsym $mod+q kill
bindsym $mod+m exit
bindsym $mod+Shift+c reload

bindsym $mod+u layout toggle split

bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

# Floating windows move by 40px, tiled ones move within the layout.
bindsym $mod+Ctrl+h move left 40px
bindsym $mod+Ctrl+l move right 40px
bindsym $mod+Ctrl+k move up 40px
bindsym $mod+Ctrl+j move down 40px

bindsym $mod+Shift+h resize shrink width 20px
bindsym $mod+Shift+l resize grow width 20px
bindsym $mod+Shift+j resize shrink height 20px
bindsym $mod+Shift+k resize grow height 20px

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Ctrl+1 move container to workspace number 1
bindsym $mod+Ctrl+2 move container to workspace number 2
bindsym $mod+Ctrl+3 move container to workspace number 3
bindsym $mod+Ctrl+4 move container to workspace number 4
bindsym $mod+Ctrl+5 move container to workspace number 5
bindsym $mod+Ctrl+6 move container to workspace number 6
bindsym $mod+Ctrl+7 move container to workspace number 7
bindsym $mod+Ctrl+8 move container to workspace number 8
bindsym $mod+Ctrl+9 move container to workspace number 9
bindsym $mod+Ctrl+0 move container to workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10

# $mod + left drag moves, $mod + right drag resizes.
floating_modifier $mod normal

# Toggle floating, centering the window when it starts floating.
bindsym $mod+f floating toggle; [con_id=__focused__ floating] move position center

# Toggle full opacity on the focused window. The mark is unique, so only one
# window at a time is tracked as opaque.
bindsym $mod+space mark --add --toggle opaque; opacity 0.9; [con_id=__focused__ con_mark="^opaque$"] opacity 1

# Screenshots (hyprshot-style): region -> clipboard, or region -> file + clipboard.
bindsym $mod+Shift+s exec ~/.config/sway/scripts/screenshot
bindsym $mod+Ctrl+Shift+s exec ~/.config/sway/scripts/screenshot ~/Pictures/Screenshots

# Toggle external-only / external + laptop.
bindsym $mod+Shift+m exec ~/.config/sway/scripts/toggle-laptop-panel

# Toggle the touchpad on/off.
bindsym $mod+t input type:touchpad events toggle enabled disabled
bindsym XF86TouchpadToggle input type:touchpad events toggle enabled disabled

bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5% && pkill -USR1 -f 'bash .*sway/scripts/status$'
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5% && pkill -USR1 -f 'bash .*sway/scripts/status$'
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && pkill -USR1 -f 'bash .*sway/scripts/status$'
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

bindsym --locked XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-

bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous

### Bar (modeline in the quicky palette: black, outlined in #993954)
bar {
    position bottom
    height 24
    font pango:Hack Nerd Font, Fira Code 10
    pango_markup enabled
    status_command ~/.config/sway/scripts/status
    status_padding 0
    status_edge_padding 0
    workspace_min_width 24

    colors {
        background #000000
        statusline #e6dde0
        separator  #57444a
        # class            border  bg      text
        focused_workspace  #993954 #2b1018 #e6dde0
        active_workspace   #15080c #15080c #e6dde0
        inactive_workspace #000000 #000000 #8b7076
        urgent_workspace   #d2536a #000000 #d2536a
        binding_mode       #993954 #993954 #e6dde0
    }
}

include /etc/sway/config.d/*
