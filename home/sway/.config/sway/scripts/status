#!/usr/bin/env bash
# Modeline for swaybar, in the quicky palette.
#
# Kept deliberately cheap: everything but wifi is a /sys read or a bash
# builtin, so a normal tick forks nothing. nmcli runs once every 30s, and
# pactl only while an audio server is actually listening. Send USR1 to
# redraw immediately (the volume keys do), USR2 to re-read wifi as well.

fg='#e6dde0'
dim='#8b7076'
accent='#993954'
warn='#d8a05a'
crit='#d2536a'

# The package sensor if there is one, else whatever zone comes first.
temp_file=
for z in /sys/class/thermal/thermal_zone*; do
    [[ $(<"$z/type") == x86_pkg_temp ]] && { temp_file=$z/temp; break; }
done
[[ -z $temp_file ]] && temp_file=$(ls /sys/class/thermal/thermal_zone*/temp 2>/dev/null | head -n1)

bat=/sys/class/power_supply/BAT0
bt_rfkill=
for r in /sys/class/rfkill/rfkill*; do
    [[ $(<"$r/type") == bluetooth ]] && { bt_rfkill=$r; break; }
done
pulse_sock=${XDG_RUNTIME_DIR:-/run/user/$UID}/pulse/native
dnd_flag=${XDG_RUNTIME_DIR:-/run/user/$UID}/dnd   # set by notif-menu

# A dim label followed by its value.
seg() {
    local s
    printf -v s '<span color="%s">%s</span> <span color="%s">%s</span>' "$dim" "$1" "${3:-$fg}" "$2"
    line+="$s  "
}

esc() { local s=${1//&/&amp;}; s=${s//</&lt;}; printf '%s' "${s//>/&gt;}"; }

wifi=
wifi_age=999
refresh_wifi() {
    wifi=off
    while IFS=: read -r type state conn; do
        [[ $type == wifi && $state == connected ]] && { wifi=$(esc "$conn"); break; }
    done < <(nmcli -t -f TYPE,STATE,CONNECTION dev 2>/dev/null)
    wifi_age=0
}

# A pipe nothing ever writes to: `read -t` on it is a sleep without a fork,
# and USR1 cuts it short by writing into it.
exec {idle}<> <(:)
trap 'echo >&$idle' USR1
trap 'wifi_age=999; echo >&$idle' USR2

while :; do
    line=

    if [[ -n $temp_file ]]; then
        read -r t < "$temp_file"; t=$(( t / 1000 ))
        c=$fg; (( t >= 80 )) && c=$crit || { (( t >= 70 )) && c=$warn; }
        seg temp "${t}°" "$c"
    fi

    if [[ -S $pulse_sock ]]; then
        if [[ $(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null) == *yes ]]; then
            seg vol muted "$dim"
        else
            v=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null)
            [[ $v =~ ([0-9]+)% ]] && seg vol "${BASH_REMATCH[1]}%"
        fi
    fi

    (( wifi_age >= 30 )) && refresh_wifi
    c=$fg; [[ $wifi == off ]] && c=$dim
    seg wifi "$wifi" "$c"

    if [[ -n $bt_rfkill ]]; then
        read -r soft < "$bt_rfkill/soft"; read -r hard < "$bt_rfkill/hard"
        (( soft == 0 && hard == 0 )) && seg bt on || seg bt off "$dim"
    fi

    if [[ -d $bat ]]; then
        read -r cap < "$bat/capacity"; read -r st < "$bat/status"
        c=$fg; (( cap <= 10 )) && c=$crit || { (( cap <= 20 )) && c=$warn; }
        case $st in Charging) mark=+ ;; Full) mark= ;; *) mark=- ;; esac
        seg bat "${cap}%${mark}" "$c"
    fi

    [[ -e $dnd_flag ]] && seg notif dnd "$warn"

    printf -v now '%(%a %d %b  %H:%M)T' -1
    # Two spaces between segments, like a modeline; the clock is the accent block.
    printf '%s<span background="%s" color="%s"> %s </span>\n' "$line" "$accent" "$fg" "$now"

    # Wake on the minute so the clock is never late, but at least every 5s.
    printf -v sec '%(%S)T' -1
    wait_for=$(( 60 - 10#$sec )); (( wait_for > 5 )) && wait_for=5
    wifi_age=$(( wifi_age + wait_for ))
    read -r -t "$wait_for" -u "$idle"
done
